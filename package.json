{
  "name": "mutialytics",
  "version": "1.2.0",
  "description": "Community-Based Monitoring System (CBMS 2022 / 2024 Desktop Analytics)",
  "author": "Kiven Cantila",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite dev",
    "setup": "npm install",
    "start": "npm run dev",
    "build": "cross-env NITRO_PRESET=node-server NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:dev": "cross-env NITRO_PRESET=node-server NODE_OPTIONS=--max-old-space-size=8192 vite build --mode development",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:8080 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:cloudflare": "cross-env CLOUDFLARE=true vite build",
    "electron:publish": "npm run build && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.cbms.insights",
    "productName": "Mutia Insight",
    "icon": "src/assets/android-chrome-512x512.png",
    "directories": {
      "output": "release"
    },
    "files": [
      ".output/**/*",
      "main.cjs",
      "preload.cjs",
      "electron/**/*",
      "src/assets/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE_EULA.txt"
    },
    "win": {
      "icon": "src/assets/android-chrome-512x512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "src/assets/android-chrome-512x512.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "cantilakiven",
      "repo": "cbms-mutia_system",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "@zip.js/zip.js": "^2.8.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.456.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serve-handler": "^6.1.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "seroval": "^1.6.2",
    "seroval-plugins": "^1.6.2"
  },
  "resolutions": {
    "seroval": "^1.6.2",
    "seroval-plugins": "^1.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cantilakiven/cbms-mutia_system.git"
  }
}
